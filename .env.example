# ============================================================
# KVL INTERNATIONAL SCHOOL — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ─── APPLICATION ─────────────────────────────────────────────
NODE_ENV=development
APP_NAME="KVL International School"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001
STUDENT_URL=http://localhost:3002
PARENT_URL=http://localhost:3003
TEACHER_URL=http://localhost:3004

# Frontend public API URL (used at build time for Next.js apps)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── MONGODB ──────────────────────────────────────────────────
# Development: no auth required
# Production:  full URI with credentials
MONGODB_URI=mongodb://localhost:27017/school_ecosystem
# MONGODB_URI=mongodb://school_admin:school_password@mongodb:27017/school_ecosystem?authSource=admin

# ─── POSTGRESQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=school_ecosystem
POSTGRES_USER=school_admin
POSTGRES_PASSWORD=school_password
DATABASE_URL=postgresql://school_admin:school_password@localhost:5432/school_ecosystem

# ─── REDIS ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=school_redis_pass
REDIS_URL=redis://:school_redis_pass@localhost:6379
REDIS_TTL_SECONDS=3600

# ─── JWT AUTHENTICATION ───────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=CHANGE_ME_min64chars_random_hex_string_for_access_tokens_here
JWT_REFRESH_SECRET=CHANGE_ME_min64chars_random_hex_string_for_refresh_tokens_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── SESSION ──────────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME_min32chars_session_secret
ENCRYPTION_KEY=CHANGE_ME_exactly_32_chars_aes_key
BCRYPT_ROUNDS=12

# ─── RAZORPAY PAYMENTS ────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── AWS S3 FILE STORAGE ──────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=kvl-school-storage
AWS_CLOUDFRONT_URL=https://your-distribution.cloudfront.net
# Or use Cloudinary instead:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ─── EMAIL (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@kvlschool.edu.in
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="KVL International School <noreply@kvlschool.edu.in>"
EMAIL_REPLY_TO=info@kvlschool.edu.in

# ─── SMS — FAST2SMS (India) ───────────────────────────────────
FAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_SENDER_ID=KVLSCL

# ─── SMS — TWILIO (International) ────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── WHATSAPP — WATI ─────────────────────────────────────────
WATI_API_URL=https://live-mt-server.wati.io
WATI_API_TOKEN=your_wati_bearer_token

# ─── GOOGLE APIs ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key
GOOGLE_RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key

# ─── OPENAI — AI Features ─────────────────────────────────────
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# Alternative: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── JITSI — Video Conferencing ──────────────────────────────
JITSI_URL=https://meet.jit.si
JITSI_APP_ID=your_jitsi_app_id
JITSI_APP_SECRET=your_jitsi_app_secret

# ─── ZOOM (Alternative) ───────────────────────────────────────
ZOOM_API_KEY=your_zoom_api_key
ZOOM_API_SECRET=your_zoom_api_secret
ZOOM_ACCOUNT_ID=your_zoom_account_id

# ─── FIREBASE (Push Notifications) ───────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ─── RATE LIMITING ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# ─── FILE UPLOADS ────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
UPLOAD_PATH=./uploads
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/ogg
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# ─── LOGGING ─────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ─── FEATURE FLAGS ───────────────────────────────────────────
FEATURE_AI_ASSISTANT=true
FEATURE_LIVE_STREAMING=true
FEATURE_ECOMMERCE=true
FEATURE_HOSTEL=true
FEATURE_TRANSPORT=true
FEATURE_LIBRARY=true
FEATURE_HR_PAYROLL=true
FEATURE_ONLINE_EXAMS=true
FEATURE_MOBILE_APP=true

# ─── SCHOOL-SPECIFIC ─────────────────────────────────────────
SCHOOL_NAME="KVL International School"
SCHOOL_CODE=KVL-MH-001
SCHOOL_BOARD=CBSE
SCHOOL_AFFILIATION_NO=1234567
CURRENT_ACADEMIC_YEAR=2025-26
FINE_PER_DAY_LIBRARY=2
FINE_PER_WEEK_FEE_LATE=500
